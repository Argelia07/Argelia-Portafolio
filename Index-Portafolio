	<script>
    function mostrarVideo(id) {
        const videos = document.querySelectorAll("div[id$='Video']");
        videos.forEach(video => {
            if (video.id === id) {
                video.style.display = "block";
            } else {
                video.style.display = "none";
                const vidTag = video.querySelector("video");
                if (vidTag) {
                    vidTag.pause();
                    vidTag.currentTime = 0;
                }
            }
        });
    }
</script>
